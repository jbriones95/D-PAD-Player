<?xml version="1.0" encoding="utf-8"?>
<!--
  Reusable empty / loading / no-results state.
  Bind with StateViewBinder.showEmpty(title, body), .showLoading(msg), .showNoResults(q), .hide()
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.LinearLayout">

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/state_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorSize="40dp"
        app:trackThickness="4dp" />

    <ImageView
        android:id="@+id/state_icon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginBottom="16dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_music_note"
        android:visibility="gone"
        app:tint="?attr/colorOnSurfaceVariant" />

    <TextView
        android:id="@+id/state_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textColor="?android:attr/textColorPrimary"
        android:visibility="gone"
        tools:text="No songs found" />

    <TextView
        android:id="@+id/state_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?android:attr/textColorSecondary"
        android:visibility="gone"
        tools:text="DPAD Music could not find any audio on this device." />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/state_action"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:minHeight="48dp"
        android:visibility="gone"
        tools:text="Rescan library" />

</merge>
