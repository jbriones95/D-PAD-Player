<?xml version="1.0" encoding="utf-8"?>
<!--
  Shared compact mini-player bar.

  Included by fragment_home.xml and fragment_library.xml. The `nextFocusUp`
  target differs per host (recycler_menu vs view_pager), so MiniPlayerBinder
  wires that link at runtime instead of hard-coding it here.

  Bind with MiniPlayerBinder.attach(root, focusUpTargetId).
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mini_player"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurfaceVariant"
    android:elevation="4dp"
    android:focusable="false"
    android:focusableInTouchMode="false"
    android:clickable="false">

    <ImageView
        android:id="@+id/mini_art"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="8dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_music_note"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toTopOf="@+id/mini_progress"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/mini_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="4dp"
        android:ellipsize="marquee"
        android:focusable="false"
        android:marqueeRepeatLimit="marquee_forever"
        android:singleLine="true"
        android:text="@string/msg_no_track_playing"
        android:textAppearance="?attr/textAppearanceTitleSmall"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/mini_artist"
        app:layout_constraintEnd_toStartOf="@+id/mini_btn_play"
        app:layout_constraintStart_toEndOf="@+id/mini_art"
        app:layout_constraintTop_toTopOf="@+id/mini_art"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/mini_artist"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="4dp"
        android:ellipsize="end"
        android:singleLine="true"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?android:attr/textColorSecondary"
        app:layout_constraintBottom_toBottomOf="@+id/mini_art"
        app:layout_constraintEnd_toStartOf="@+id/mini_btn_play"
        app:layout_constraintStart_toEndOf="@+id/mini_art"
        app:layout_constraintTop_toBottomOf="@+id/mini_title" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/mini_btn_play"
        style="@style/Widget.MaterialComponents.Button.Icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:minWidth="0dp"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:text=""
        android:focusable="true"
        android:focusableInTouchMode="false"
        android:nextFocusLeft="@id/mini_open_player"
        android:nextFocusRight="@id/mini_btn_next"
        app:icon="@drawable/ic_play"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:layout_constraintBottom_toTopOf="@+id/mini_progress"
        app:layout_constraintEnd_toStartOf="@+id/mini_btn_next"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/mini_btn_next"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton.Icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="4dp"
        android:minWidth="0dp"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:text=""
        android:focusable="true"
        android:focusableInTouchMode="false"
        android:nextFocusLeft="@id/mini_btn_play"
        app:icon="@drawable/ic_skip_next"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:layout_constraintBottom_toTopOf="@+id/mini_progress"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/mini_progress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:indicatorColor="?attr/colorPrimary"
        app:trackColor="?attr/colorSurfaceVariant"
        app:trackThickness="3dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Transparent focusable overlay over art+text. Single focus stop that
         opens the full player, so the bar doesn't read as three separate
         unlabeled controls. -->
    <View
        android:id="@+id/mini_open_player"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clickable="true"
        android:focusable="true"
        android:focusableInTouchMode="false"
        android:nextFocusRight="@id/mini_btn_play"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/mini_progress"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/mini_btn_play" />

</androidx.constraintlayout.widget.ConstraintLayout>
