<?xml version="1.0" encoding="utf-8"?>
<!-- Folder row: folder icon + name. Used by the Folders library tab. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/item_track_height"
    android:paddingTop="@dimen/item_track_padding_v"
    android:paddingBottom="@dimen/item_track_padding_v"
    android:paddingStart="@dimen/item_track_padding_h"
    android:paddingEnd="@dimen/item_track_padding_h"
    android:focusable="false"
    android:focusableInTouchMode="false"
    android:background="@android:color/transparent">

    <ImageView
        android:id="@+id/iv_folder_icon"
        android:layout_width="@dimen/item_track_art_size"
        android:layout_height="@dimen/item_track_art_size"
        android:src="@drawable/ic_folder"
        android:scaleType="centerInside"
        android:padding="8dp"
        android:importantForAccessibility="no"
        app:tint="?attr/colorPrimary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_item_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:textAppearance="?attr/textAppearanceTitleSmall"
        android:textColor="?attr/colorOnSurface"
        android:singleLine="true"
        android:ellipsize="middle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/iv_folder_icon"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Focusable/clickable overlay covering the whole row. -->
    <FrameLayout
        android:id="@+id/clickable_item"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:focusable="true"
        android:focusableInTouchMode="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
